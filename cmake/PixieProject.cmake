# Installed-package project support. Source development is an explicit separate mode.
# Pure metadata functions are also available to script-mode preserving generators.

function(_pixie_project_json output document)
    string(JSON value ERROR_VARIABLE problem GET "${document}" ${ARGN})
    if(problem)
        message(FATAL_ERROR "Unsupported project/SDK metadata (${ARGN}): ${problem}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_pixie_project_json_type document type)
    string(JSON actual ERROR_VARIABLE problem TYPE "${document}" ${ARGN})
    if(problem OR NOT actual STREQUAL type)
        message(FATAL_ERROR "Unsupported project/SDK metadata (${ARGN}): expected ${type}")
    endif()
endfunction()

function(_pixie_project_cpu output document)
    _pixie_project_json_type("${document}" ARRAY cpuFeatures)
    string(JSON count ERROR_VARIABLE problem LENGTH "${document}" cpuFeatures)
    if(problem OR NOT count EQUAL 3)
        message(FATAL_ERROR "SDK/project CPU baseline requires AVX2, FMA and F16C")
    endif()
    math(EXPR last "${count} - 1")
    set(features "")
    foreach(index RANGE 0 ${last})
        _pixie_project_json(feature "${document}" cpuFeatures ${index})
        if(NOT feature MATCHES "^(avx2|fma|f16c)$" OR feature IN_LIST features)
            message(FATAL_ERROR "Unknown or duplicate SDK CPU feature: ${feature}")
        endif()
        list(APPEND features "${feature}")
    endforeach()
    list(SORT features)
    set(${output} "${features}" PARENT_SCOPE)
endfunction()

function(pixie_sdk_profile_identity profile output)
    if(NOT IS_ABSOLUTE "${PIXIE_SDK_ROOT}" OR NOT EXISTS "${PIXIE_SDK_ROOT}/sdk.json" OR
       IS_SYMLINK "${PIXIE_SDK_ROOT}/sdk.json")
        message(FATAL_ERROR "PIXIE_SDK_ROOT must select an installed SDK; no source/ancestor fallback")
    endif()
    file(READ "${PIXIE_SDK_ROOT}/sdk.json" manifest)
    _pixie_project_json_type("${manifest}" NUMBER schemaVersion)
    _pixie_project_json_type("${manifest}" ARRAY profiles)
    _pixie_project_json(schema "${manifest}" schemaVersion)
    _pixie_project_json(sdk_id "${manifest}" sdkId)
    _pixie_project_json(distribution "${manifest}" distributionClass)
    string(LENGTH "${sdk_id}" id_size)
    if(NOT schema STREQUAL "1" OR NOT id_size EQUAL 64 OR NOT sdk_id MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Unsupported installed SDK schema/identity")
    endif()
    if((profile STREQUAL "local-development" AND NOT distribution STREQUAL "local-private") OR
       (NOT profile STREQUAL "local-development" AND NOT distribution STREQUAL "public"))
        message(FATAL_ERROR "SDK profile/distribution mismatch")
    endif()
    string(JSON count LENGTH "${manifest}" profiles)
    if(count LESS 1)
        message(FATAL_ERROR "The selected SDK has no profiles")
    endif()
    math(EXPR last "${count} - 1")
    set(found FALSE)
    set(configurations "")
    foreach(index RANGE 0 ${last})
        _pixie_project_json(name "${manifest}" profiles ${index} profile)
        if(name STREQUAL profile)
            _pixie_project_json(configuration "${manifest}" profiles ${index} configuration)
            _pixie_project_json(path "${manifest}" profiles ${index} manifest)
            _pixie_project_json(expected_hash "${manifest}" profiles ${index} manifestSha256)
            if(NOT configuration MATCHES "^(Debug|Release)$" OR configuration IN_LIST configurations OR
               (profile STREQUAL "shipping" AND NOT configuration STREQUAL "Release") OR
               NOT path STREQUAL "profiles/${profile}/${configuration}/profile.json")
                message(FATAL_ERROR "SDK profile has an invalid configuration/path")
            endif()
            list(APPEND configurations "${configuration}")
            if(NOT EXISTS "${PIXIE_SDK_ROOT}/${path}" OR IS_SYMLINK "${PIXIE_SDK_ROOT}/${path}")
                message(FATAL_ERROR "SDK profile metadata is missing or linked")
            endif()
            file(SHA256 "${PIXIE_SDK_ROOT}/${path}" actual_hash)
            if(NOT expected_hash STREQUAL actual_hash)
                message(FATAL_ERROR "SDK profile metadata hash mismatch")
            endif()
            file(READ "${PIXIE_SDK_ROOT}/${path}" identity)
            _pixie_project_json(identity_id "${identity}" sdkId)
            _pixie_project_json(identity_profile "${identity}" profile)
            _pixie_project_json(identity_distribution "${identity}" distributionClass)
            _pixie_project_json(identity_configuration "${identity}" configuration)
            _pixie_project_json(identity_build "${identity}" sdkBuildId)
            _pixie_project_json(expected_build "${manifest}" profiles ${index} sdkBuildId)
            _pixie_project_json(compiler "${identity}" compilerVersion)
            _pixie_project_json(platform "${identity}" platform)
            _pixie_project_json(architecture "${identity}" architecture)
            if(NOT identity_id STREQUAL sdk_id OR NOT identity_profile STREQUAL profile OR
               NOT identity_distribution STREQUAL distribution OR NOT identity_configuration STREQUAL configuration OR
               NOT identity_build STREQUAL expected_build OR NOT compiler MATCHES "^[0-9]+(\\.[0-9]+)+$" OR
               NOT platform STREQUAL "windows" OR NOT architecture STREQUAL "x64")
                message(FATAL_ERROR "Mixed SDK profile identity")
            endif()
            if(NOT found)
                set(first_identity "${identity}")
                set(found TRUE)
            endif()
            # Portable requirements describe common toolchain/platform/CPU, not one
            # machine path or the managed application's Debug/Release label.
            foreach(field compilerVersion platform architecture)
                _pixie_project_json(first "${first_identity}" ${field})
                _pixie_project_json(current "${identity}" ${field})
                if(NOT first STREQUAL current)
                    message(FATAL_ERROR "SDK profile configurations disagree on ${field}")
                endif()
            endforeach()
            _pixie_project_cpu(first_cpu "${first_identity}")
            _pixie_project_cpu(current_cpu "${identity}")
            if(NOT first_cpu STREQUAL current_cpu)
                message(FATAL_ERROR "SDK profile configurations disagree on CPU requirements")
            endif()
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "The selected SDK has no ${profile} profile")
    endif()
    set(${output} "${first_identity}" PARENT_SCOPE)
endfunction()

# Portable authoring intent excludes machine paths, catalog hashes and configuration build IDs.
function(pixie_sdk_requirement output)
    if(NOT PIXIE_SDK_PROFILE MATCHES "^(authoring|local-development)$")
        message(FATAL_ERROR "Portable project adoption requires an admitted authoring profile")
    endif()
    pixie_sdk_profile_identity("${PIXIE_SDK_PROFILE}" identity)
    foreach(field sdkId profile platform architecture compilerVersion)
        _pixie_project_json(${field} "${identity}" ${field})
    endforeach()
    _pixie_project_cpu(cpu "${identity}")
    list(JOIN cpu "\", \"" cpu_json)
    set(${output} "{\n  \"schemaVersion\": 1,\n  \"sdkId\": \"${sdkId}\",\n  \"profile\": \"${profile}\",\n  \"platform\": \"${platform}\",\n  \"architecture\": \"${architecture}\",\n  \"compilerVersion\": \"${compilerVersion}\",\n  \"cpuFeatures\": [\"${cpu_json}\"]\n}\n" PARENT_SCOPE)
endfunction()

function(pixie_validate_project_sdk directory)
    set(path "${directory}/.pixie-code/sdk.json")
    if(NOT EXISTS "${path}" OR IS_SYMLINK "${path}" OR IS_SYMLINK "${directory}/.pixie-code")
        message(FATAL_ERROR "A portable .pixie-code/sdk.json is required; explicitly adopt the selected SDK before building/generating")
    endif()
    file(READ "${path}" requirement)
    _pixie_project_json_type("${requirement}" NUMBER schemaVersion)
    _pixie_project_json(schema "${requirement}" schemaVersion)
    if(NOT schema STREQUAL "1")
        message(FATAL_ERROR "Unsupported portable SDK requirement schema")
    endif()
    string(JSON members LENGTH "${requirement}")
    math(EXPR last_member "${members} - 1")
    foreach(index RANGE 0 ${last_member})
        string(JSON member MEMBER "${requirement}" ${index})
        if(NOT member MATCHES "^(schemaVersion|sdkId|profile|platform|architecture|compilerVersion|cpuFeatures|requiredCapabilities)$")
            message(FATAL_ERROR "Unknown or machine-local field in portable SDK requirements: ${member}")
        endif()
    endforeach()
    _pixie_project_json(required_profile "${requirement}" profile)
    if(NOT DEFINED PIXIE_PROJECT_BUILD_ROLE)
        set(PIXIE_PROJECT_BUILD_ROLE authoring)
    endif()
    if(PIXIE_PROJECT_BUILD_ROLE STREQUAL "authoring")
        if(NOT PIXIE_SDK_PROFILE MATCHES "^(authoring|local-development)$" OR NOT required_profile STREQUAL PIXIE_SDK_PROFILE)
            message(FATAL_ERROR "Authoring requires the exact admitted project/selected SDK profile")
        endif()
    elseif(PIXIE_PROJECT_BUILD_ROLE STREQUAL "shipping-export")
        # Match the project's public authoring intent to the selected public shipping tuple.
        if(NOT PIXIE_SDK_PROFILE STREQUAL "shipping" OR NOT required_profile STREQUAL "authoring")
            message(FATAL_ERROR "Shipping export requires the public shipping tuple and a public authoring requirement; private fallback is forbidden")
        endif()
        if((DEFINED CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL "" AND NOT CMAKE_BUILD_TYPE STREQUAL "Release") OR
           (DEFINED CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Release"))
            message(FATAL_ERROR "Shipping export requires the explicit Release configuration")
        endif()
        pixie_sdk_profile_identity(shipping shipping_identity)
    else()
        message(FATAL_ERROR "Unknown PIXIE_PROJECT_BUILD_ROLE; use authoring or explicit shipping-export")
    endif()
    pixie_sdk_profile_identity("${required_profile}" expected)
    foreach(field sdkId platform architecture compilerVersion)
        _pixie_project_json(actual "${requirement}" ${field})
        _pixie_project_json(wanted "${expected}" ${field})
        if(NOT actual STREQUAL wanted)
            message(FATAL_ERROR "Project SDK requirement mismatch: ${field}; explicit adoption and a new compatible cache are required")
        endif()
        if(PIXIE_PROJECT_BUILD_ROLE STREQUAL "shipping-export")
            _pixie_project_json(shipping_value "${shipping_identity}" ${field})
            if(NOT shipping_value STREQUAL wanted)
                message(FATAL_ERROR "Shipping SDK is not the project's public authoring SDK/toolchain")
            endif()
        endif()
    endforeach()
    _pixie_project_cpu(actual_cpu "${requirement}")
    _pixie_project_cpu(expected_cpu "${expected}")
    if(NOT actual_cpu STREQUAL expected_cpu)
        message(FATAL_ERROR "Project SDK CPU requirement mismatch")
    endif()
    if(PIXIE_PROJECT_BUILD_ROLE STREQUAL "shipping-export")
        _pixie_project_cpu(shipping_cpu "${shipping_identity}")
        if(NOT shipping_cpu STREQUAL expected_cpu)
            message(FATAL_ERROR "Shipping SDK CPU baseline differs from authoring requirements")
        endif()
    endif()
    string(JSON capability_type ERROR_VARIABLE absent TYPE "${requirement}" requiredCapabilities)
    if(NOT absent)
        if(NOT capability_type STREQUAL "ARRAY")
            message(FATAL_ERROR "requiredCapabilities must be an array")
        endif()
        string(JSON count LENGTH "${requirement}" requiredCapabilities)
    endif()
    if(NOT absent AND count GREATER 0)
        math(EXPR last "${count} - 1")
        set(capabilities "")
        foreach(index RANGE 0 ${last})
            _pixie_project_json(capability "${requirement}" requiredCapabilities ${index})
            if(NOT capability MATCHES "^(moduleLoading|nativeAutomation|candidateAuthoring)$" OR capability IN_LIST capabilities)
                message(FATAL_ERROR "Unknown or duplicate required SDK capability: ${capability}")
            endif()
            list(APPEND capabilities "${capability}")
            _pixie_project_json_type("${expected}" BOOLEAN capabilities ${capability})
            _pixie_project_json(admitted "${expected}" capabilities ${capability})
            if(NOT admitted)
                message(FATAL_ERROR "The declared authoring role cannot supply required capability: ${capability}")
            endif()
        endforeach()
    endif()
endfunction()

# Plan an explicit adoption without writing. Generators call this before their
# destination preflight, then publish the new requirement only with owned outputs.
function(pixie_prepare_project_requirement directory contents write_new)
    if(DEFINED PIXIE_PROJECT_ADOPT_SDK AND NOT PIXIE_PROJECT_ADOPT_SDK MATCHES "^(ON|OFF)$")
        message(FATAL_ERROR "PIXIE_PROJECT_ADOPT_SDK must be explicit ON/OFF")
    endif()
    if(DEFINED PIXIE_PROJECT_BUILD_ROLE AND NOT PIXIE_PROJECT_BUILD_ROLE STREQUAL "authoring")
        message(FATAL_ERROR "Project generation requires the authoring role; export cannot adopt or write project code")
    endif()
    set(path "${directory}/.pixie-code/sdk.json")
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
        pixie_validate_project_sdk("${directory}")
        set(${contents} "" PARENT_SCOPE)
        set(${write_new} FALSE PARENT_SCOPE)
    elseif(PIXIE_PROJECT_ADOPT_SDK STREQUAL "ON")
        pixie_sdk_requirement(requirement)
        set(${contents} "${requirement}" PARENT_SCOPE)
        set(${write_new} TRUE PARENT_SCOPE)
    else()
        message(FATAL_ERROR "This project has no SDK requirement; explicitly confirm adoption before generation")
    endif()
endfunction()

if(NOT CMAKE_SCRIPT_MODE_FILE)
    if(NOT DEFINED PIXIE_ENGINE_MODE)
        set(PIXIE_ENGINE_MODE PACKAGE)
    endif()
    set(PIXIE_OUTPUT_ROOT "${CMAKE_SOURCE_DIR}/bin" CACHE PATH "Root for this project's native outputs")
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${PIXIE_OUTPUT_ROOT}/$<CONFIG>")
    set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${PIXIE_OUTPUT_ROOT}/$<CONFIG>")
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    if(PIXIE_ENGINE_MODE STREQUAL "SOURCE")
        if(NOT IS_DIRECTORY "${PIXIE_ENGINE_DIR}" OR NOT EXISTS "${PIXIE_ENGINE_DIR}/cmake/PixieProject.cmake")
            message(FATAL_ERROR "Explicit Source mode requires PIXIE_ENGINE_DIR=<Engine source root>")
        endif()
        add_subdirectory("${PIXIE_ENGINE_DIR}" pixie-engine)
    elseif(PIXIE_ENGINE_MODE STREQUAL "PACKAGE")
        if(NOT DEFINED PIXIE_PROJECT_BUILD_ROLE)
            set(PIXIE_PROJECT_BUILD_ROLE authoring)
        endif()
        pixie_validate_project_sdk("${CMAKE_CURRENT_SOURCE_DIR}")
        set(pixie_selected_config "${PIXIE_SDK_ROOT}/lib/cmake/PixieEngine")
        if(NOT EXISTS "${pixie_selected_config}/PixieEngineConfig.cmake")
            message(FATAL_ERROR "The selected SDK has no installed PixieEngine CMake config")
        endif()
        if(PixieEngine_DIR)
            file(REAL_PATH "${PixieEngine_DIR}" pixie_cached_config)
            file(REAL_PATH "${pixie_selected_config}" pixie_expected_config)
            if(NOT pixie_cached_config STREQUAL pixie_expected_config)
                message(FATAL_ERROR "PixieEngine_DIR conflicts with PIXIE_SDK_ROOT; start a new selected SDK cache")
            endif()
        endif()
        set(PixieEngine_DIR "${pixie_selected_config}")
        find_package(PixieEngine CONFIG REQUIRED PATHS "${pixie_selected_config}" NO_DEFAULT_PATH)
        unset(pixie_selected_config)
        unset(pixie_cached_config)
        unset(pixie_expected_config)
        include("${PIXIE_SDK_ROOT}/cmake/PixieTargetDefaults.cmake")
        if(PIXIE_SDK_PROFILE STREQUAL "shipping")
            set(PIXIE_DEVELOPMENT OFF)
            set(PIXIE_DEV_CHANNEL OFF)
        else()
            set(PIXIE_DEVELOPMENT ON)
            set(PIXIE_DEV_CHANNEL OFF)
            if(PIXIE_SDK_PROFILE STREQUAL "local-development")
                set(PIXIE_DEV_CHANNEL ON)
            endif()
        endif()
        include("${PIXIE_SDK_ROOT}/cmake/PixieGame.cmake")
    else()
        message(FATAL_ERROR "PIXIE_ENGINE_MODE must be PACKAGE or explicit SOURCE; no fallback")
    endif()
endif()

# The editor's managed component registry attaches to the project's existing game library.
# Never guess an executable or attach generated code to an engine target.
function(pixie_project_components)
    get_property(targets DIRECTORY PROPERTY PIXIE_GAME_CODE_TARGETS)
    list(LENGTH targets count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Generated components require exactly one pixie_game in this directory. Wire the registry explicitly for a custom multi-game project.")
    endif()
    list(GET targets 0 PIXIE_COMPONENT_TARGET)
    set(registry "${CMAKE_CURRENT_SOURCE_DIR}/.pixie-code/Components.cmake")
    if(NOT EXISTS "${registry}")
        message(FATAL_ERROR "Component source registry is missing: ${registry}. Restore the generated project-code files.")
    endif()
    include("${registry}")
endfunction()
