function(project_fixture dir)
    file(WRITE "${dir}/Proof Game.pixie" "{\"name\":\"Proof Game\",\"startScene\":\"scenes/main.scene\"}\n")
    file(WRITE "${dir}/scenes/main.scene" "{\"format\":\"pixie-scene\",\"version\":1,\"entities\":[]}\n")
