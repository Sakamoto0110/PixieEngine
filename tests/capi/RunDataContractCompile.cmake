if(NOT DEFINED BUILD_DIR OR NOT DEFINED CONFIG)
    message(FATAL_ERROR "BUILD_DIR and CONFIG are required")
endif()
set(evidence "${BUILD_DIR}/tests/data-contract-${CONFIG}")
file(MAKE_DIRECTORY "${evidence}")
foreach(case RANGE 0 12)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD_DIR}" --config "${CONFIG}"
        --target "data-contract-${case}" --parallel 1
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${evidence}/case-${case}.log" "${output}\n${error}")
    if(case EQUAL 0)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Positive data-contract control failed: ${evidence}/case-${case}.log")
        endif()
    else()
        if(result EQUAL 0)
            message(FATAL_ERROR "Forbidden data-contract case ${case} compiled")
        endif()
        if(case EQUAL 5 OR case EQUAL 6)
            set(reason "private|C2248")
        elseif(case EQUAL 7 OR case EQUAL 10 OR case EQUAL 11)
            set(reason "declarative fields are direct scalar values|declarative components require")
        elseif(case EQUAL 8 OR case EQUAL 9)
            set(reason "declarative integers/enums are limited to 32 bits")
        else()
            set(reason "declarative components require")
        endif()
        if(NOT "${output}\n${error}" MATCHES "${reason}")
            message(FATAL_ERROR "Case ${case} failed for an unexpected reason: ${evidence}/case-${case}.log")
        endif()
    endif()
    message(STATUS "Data contract case ${case}: expected result observed (${result})")
endforeach()
