    list(GET fields 0 field)
    list(GET fields 1 path)
    file(SHA256 "${default}/${path}" actual)
    string(JSON expected GET "${registry}" "${field}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Registry hashes do not bind the generated file bytes")
    endif()
endforeach()
