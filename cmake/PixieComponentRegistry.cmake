# Shared bootstrap for Add code and explicit adoption by a custom C++ project.
function(pixie_initialize_component_registry directory project_id)
    foreach(path src/PixieComponents.generated.hpp src/PixieComponents.generated.cpp .pixie-code/Components.cmake .pixie-code/manifest.json)
        if(EXISTS "${directory}/${path}" OR IS_SYMLINK "${directory}/${path}")
            message(FATAL_ERROR "Refusing to replace an existing registry file: ${path}")
        endif()
    endforeach()
    foreach(path src .pixie-code)
        if(EXISTS "${directory}/${path}" AND NOT IS_DIRECTORY "${directory}/${path}")
            message(FATAL_ERROR "A registry directory is an existing file: ${path}")
        endif()
        if(IS_SYMLINK "${directory}/${path}")
            message(FATAL_ERROR "Registry destinations must not be linked directories: ${path}")
        endif()
    endforeach()
    set(templates "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../templates/project-code")
    configure_file("${templates}/Components.hpp.in" "${directory}/src/PixieComponents.generated.hpp" @ONLY)
    configure_file("${templates}/Components.cpp.in" "${directory}/src/PixieComponents.generated.cpp" @ONLY)
    configure_file("${templates}/Components.cmake.in" "${directory}/.pixie-code/Components.cmake" @ONLY)
    file(SHA256 "${directory}/src/PixieComponents.generated.hpp" header_hash)
    file(SHA256 "${directory}/src/PixieComponents.generated.cpp" source_hash)
    file(SHA256 "${directory}/.pixie-code/Components.cmake" cmake_hash)
    file(WRITE "${directory}/.pixie-code/manifest.json"
        "{\n  \"schemaVersion\": 1,\n  \"projectId\": \"${project_id}\",\n  \"components\": [],\n  \"headerHash\": \"${header_hash}\",\n  \"sourceHash\": \"${source_hash}\",\n  \"cmakeHash\": \"${cmake_hash}\"\n}\n")
endfunction()
