<Project Sdk="Microsoft.NET.Sdk">

  <!-- The checks of the primitives, the same values as cpp/tests, without a test framework. They run on
       .NET 10 and, on Windows, on the .NET Framework (net481), where NekoLib uses PixieLib. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Only for the layout checks (Unsafe, MemoryMarshal): PixieLib itself depends on nothing. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixieLib\PixieLib.csproj" />
  </ItemGroup>

</Project>
