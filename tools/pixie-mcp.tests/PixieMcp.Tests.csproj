<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ModelContextProtocol" Version="2.3.0" /></ItemGroup>
  <Target Name="RefusePublish" BeforeTargets="PrepareForPublish;Publish">
    <Error Text="Development qualification clients cannot be published." />
  </Target>
</Project>
