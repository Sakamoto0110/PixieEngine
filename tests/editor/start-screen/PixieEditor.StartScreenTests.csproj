<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../editor/PixieEditor/PixieEditor.csproj" />
    <Compile Include="../../../editor/PixieEditor/Ui/FolderBrowser.cs" Link="FolderBrowser.cs" />
  </ItemGroup>
  <Target Name="RefusePublish" BeforeTargets="PrepareForPublish;Publish">
    <Error Text="Start screen tests cannot be published." />
  </Target>
</Project>
