# A successful procedure confirms a rejected experiment, not physical equivalence.
if(NOT DEFINED PROBE OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "PROBE and OUTPUT are required")
endif()
execute_process(COMMAND "${PROBE}" --changing-world-base
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 110)
file(WRITE "${OUTPUT}" "${output}${errors}")
if(NOT result STREQUAL "1")
    message(FATAL_ERROR "Expected a completed, rejected experiment (exit 1); got ${result}. See ${OUTPUT}")
endif()
if(NOT output MATCHES "changes=8,asleep_before_first_change=1,stable_body_and_shape_ids=1,unexpected_effective_changes=0")
    message(FATAL_ERROR "The fixed-override/identity/sleep preconditions were not established. See ${OUTPUT}")
endif()
string(REPLACE "\r" "" output "${output}")
string(REPLACE "\n" ";" lines "${output}")
set(normal_passes 0)
set(consumer_passes 0)
set(rejected 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^body,override-stable-changing-world-base,FAIL,")
        string(REPLACE "," ";" fields "${line}")
        list(LENGTH fields count)
        if(NOT count EQUAL 20)
            message(FATAL_ERROR "Unexpected rejection row shape: ${line}")
        endif()
        list(GET fields 14 sleep_mismatches)
        if(NOT sleep_mismatches MATCHES "^[1-9][0-9]*$")
            message(FATAL_ERROR "Expected actual sleep divergence: ${line}")
        endif()
        foreach(index IN ITEMS 12 13 15 16)
            list(GET fields ${index} value)
            if(NOT value STREQUAL "0")
                message(FATAL_ERROR "Unexpected contact/event/tunneling failure: ${line}")
            endif()
        endforeach()
        math(EXPR rejected "${rejected} + 1")
    elseif(line MATCHES "^body,[^,]+,PASS,")
        math(EXPR normal_passes "${normal_passes} + 1")
    elseif(line MATCHES "^(local-consumer|global-scene),[^,]+,PASS,")
        math(EXPR consumer_passes "${consumer_passes} + 1")
    elseif(line MATCHES "^(body|local-consumer|global-scene),")
        message(FATAL_ERROR "An unrelated comparison failed: ${line}")
    endif()
endforeach()
if(NOT normal_passes EQUAL 14 OR NOT consumer_passes EQUAL 7 OR NOT rejected EQUAL 1
        OR NOT output MATCHES "runtime experimental criteria: FAIL; no activation approval inferred")
    message(FATAL_ERROR "Incomplete experiment results. See ${OUTPUT}")
endif()
message(STATUS "Force compensation rejected for sleep divergence; production global-body fallback retained. See ${OUTPUT}")
