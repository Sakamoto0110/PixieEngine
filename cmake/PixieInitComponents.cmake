# Explicit bootstrap for custom projects. The owner wires Describe and CMake themselves;
# this command never searches for a homonymous C++ file or modifies their implementation.
# Package mode validates an existing SDK requirement or explicitly adopts a missing one.
# Source development must be selected explicitly.
cmake_minimum_required(VERSION 3.25)
if(NOT IS_DIRECTORY "${PIXIE_PROJECT_DIR}" OR NOT EXISTS "${PIXIE_PROJECT_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "PIXIE_PROJECT_DIR must name an existing C++ project.")
endif()
if(NOT PIXIE_PROJECT_ID MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Pass -DPIXIE_PROJECT_ID=<C++ project identifier> explicitly for custom code.")
endif()
file(READ "${PIXIE_PROJECT_DIR}/CMakeLists.txt" cmake_text)
string(REPLACE "\r\n" "\n" cmake_text "${cmake_text}")
set(managed_block "# BEGIN PIXIE COMPONENT SOURCES (managed)\npixie_project_components()\n# END PIXIE COMPONENT SOURCES (managed)")
string(REGEX MATCHALL "# BEGIN PIXIE COMPONENT SOURCES" begin_markers "${cmake_text}")
string(REGEX MATCHALL "# END PIXIE COMPONENT SOURCES" end_markers "${cmake_text}")
list(LENGTH begin_markers begin_count)
list(LENGTH end_markers end_count)
string(FIND "\n${cmake_text}\n" "\n${managed_block}\n" wired)
if(wired LESS 0 OR NOT begin_count EQUAL 1 OR NOT end_count EQUAL 1)
    message(FATAL_ERROR "Add pixie_project_components() after the project's pixie_game call before initializing its component registry. See docs/entity-input-and-code-components.md.")
endif()
if(NOT DEFINED PIXIE_ENGINE_MODE)
    set(PIXIE_ENGINE_MODE PACKAGE)
endif()
set(write_requirement FALSE)
if(PIXIE_ENGINE_MODE STREQUAL "PACKAGE")
    include("${CMAKE_CURRENT_LIST_DIR}/PixieProject.cmake")
    pixie_prepare_project_requirement("${PIXIE_PROJECT_DIR}" requirement write_requirement)
elseif(NOT PIXIE_ENGINE_MODE STREQUAL "SOURCE")
    message(FATAL_ERROR "PIXIE_ENGINE_MODE must be PACKAGE or explicit SOURCE")
endif()
set(PIXIE_GENERATOR_FAMILY custom-v1)
include("${CMAKE_CURRENT_LIST_DIR}/PixieComponentRegistry.cmake")
pixie_initialize_component_registry("${PIXIE_PROJECT_DIR}" "${PIXIE_PROJECT_ID}")
if(write_requirement)
    file(WRITE "${PIXIE_PROJECT_DIR}/.pixie-code/sdk.json" "${requirement}")
endif()
message(STATUS "Created the explicit component registry. Call pixie::generated::DescribeComponents(types) from your Project::Describe before rebuilding.")
