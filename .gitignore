# Unversioned working documentation and local state (see docs/governance/documentation-policy.md)
/.local/

# IDE and build output. Anchored to the root so vendored sources under external/ stay complete.
/.vs/
/.vscode/
/build/
/build-ci/
/bin/
# Generated on configure by cmake/PixieRootSolution.cmake.
/PixieEngine.slnx
/out/
*.user

# The C# editor's build output and its saved dock layout.
/editor/**/bin/
/editor/**/obj/
/tools/**/bin/
/tools/**/obj/
imgui.ini

# A sample opened in the editor is built as a project of its own, in its folder.
/samples/*/build/
/samples/*/bin/

# Python development tools keep bytecode out of source control.
__pycache__/
