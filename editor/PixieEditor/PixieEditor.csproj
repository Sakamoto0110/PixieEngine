<Project Sdk="Microsoft.NET.Sdk">

  <!-- Machine-local adoption settings also apply to normal Visual Studio builds. -->
  <Import Project="../../.local/PixieEditor.props"
          Condition="'$(PixieUseLocalConfiguration)' != 'false' And Exists('../../.local/PixieEditor.props')" />

  <PropertyGroup>
    <PixieNativeMetadataMode Condition="'$(PixieNativeMetadataMode)' == ''">Source</PixieNativeMetadataMode>
    <PixieNativeApiHeader Condition="'$(PixieNativeMetadataMode)' == 'Source' And '$(PixieNativeApiHeader)' == ''">$(MSBuildThisFileDirectory)../../capi/include/pixie_capi.h</PixieNativeApiHeader>
  </PropertyGroup>
  <Import Project="../../tools/NativeApiVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- GLFW, the ImGui backends, and the C API take native pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PixieEditor</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The existing published package remains the default. The selected pair and local source enable the same features. -->
    <_PixieInspectorFieldInteractions Condition="'$(PixieInspectorLocalRoot)' != '' Or '$(PixieInspectorPackageVersion)' == '0.3.0-pixie021.3'">true</_PixieInspectorFieldInteractions>
    <DefineConstants Condition="'$(_PixieInspectorFieldInteractions)' == 'true'">$(DefineConstants);PIXIE_INSPECTOR_FIELD_INTERACTIONS</DefineConstants>
    <PixieDevelopmentTools Condition="'$(PixieDevelopmentTools)' == ''">true</PixieDevelopmentTools>
    <DefineConstants Condition="'$(PixieDevelopmentTools)' == 'true'">$(DefineConstants);PIXIE_DEVELOPMENT</DefineConstants>
    <!-- Whether the development channel may save the scene (editor.do save); -p:PixieChannelSave=false leaves it out. -->
    <PixieChannelSave Condition="'$(PixieChannelSave)' == ''">true</PixieChannelSave>
    <DefineConstants Condition="'$(PixieDevelopmentTools)' == 'true' And '$(PixieChannelSave)' == 'true'">$(DefineConstants);PIXIE_CHANNEL_SAVE</DefineConstants>
    <!-- The neko mark from the shared asset store (vdr: neko-purple-light), copied by vdr cp. -->
    <ApplicationIcon>assets/neko-purple-light.ico</ApplicationIcon>
    <!-- The editor ships with the engine, so it carries the product version owned by version.json. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../version.json')), '(?s).*"version"\s*:\s*"([0-9.]+)".*', '$1'))</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(PixieDevelopmentTools)' != 'true'">
    <Compile Remove="Development/**/*.cs" />
    <Compile Include="Development/ExportPanel.cs;Development/ProjectExportJob.cs" />
  </ItemGroup>
  <Target Name="ValidateInspectorSelection" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(PixieInspectorPackageVersion)' != '' And '$(PixieInspectorLocalRoot)' != ''" Text="Choose the selected Inspector package pair or a local Inspector project." />
    <Error Condition="'$(PixieInspectorPackageVersion)' != '' And '$(PixieInspectorPackageVersion)' != '0.3.0-pixie021.3'" Text="The selected Inspector package pair must be 0.3.0-pixie021.3." />
  </Target>
  <Target Name="RequireShippingPublish" BeforeTargets="PrepareForPublish;Publish">
    <Error Condition="'$(PixieInspectorLocalRoot)' != ''" Text="Local Inspector integration cannot be published. Clear PixieInspectorLocalRoot." />
    <Error Condition="'$(PixieDevelopmentTools)' == 'true'" Text="Publish requires -p:PixieDevelopmentTools=false; development operations cannot be published." />
    <Error Condition="'$(NoBuild)' == 'true'" Text="Publishing an existing editor binary is not allowed; build with development tools disabled." />
  </Target>

  <ItemGroup>
    <!-- The same icon for the window, which GLFW takes as pixels (Ui/WindowIcon.cs). -->
    <EmbeddedResource Include="assets/neko-purple-light.ico" LogicalName="PixieEditor.assets.neko-purple-light.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The inspector and its Dear ImGui view, which bring the core, PixieLib, and Hexa.NET.ImGui 2.2.9;
         the window and ImGui's GLFW and OpenGL3 backends, at the versions made with that binding. -->
    <PackageReference Include="PixieInspector.ImGui" Version="0.3.0" Condition="'$(PixieInspectorLocalRoot)' == '' And '$(PixieInspectorPackageVersion)' == ''" />
    <ProjectReference Include="$(PixieInspectorLocalRoot)/views/PixieInspector.ImGui/PixieInspector.ImGui.csproj" Condition="'$(PixieInspectorLocalRoot)' != ''" />
    <PackageReference Include="Hexa.NET.GLFW" Version="1.0.5" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18" />
  </ItemGroup>

  <ItemGroup Condition="'$(PixieInspectorLocalRoot)' == '' And '$(PixieInspectorPackageVersion)' == '0.3.0-pixie021.3'">
    <PackageReference Include="PixieInspector" Version="[$(PixieInspectorPackageVersion)]" />
    <PackageReference Include="PixieInspector.ImGui" Version="[$(PixieInspectorPackageVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(_PixieInspectorFieldInteractions)' == 'true'">
    <Content Include="assets/inspector/*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
