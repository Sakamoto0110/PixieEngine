# Writes the curated Pixie workspace input next to CMake's generated native solution.
# ALL_BUILD and utility targets such as GLFW's update_mappings are omitted. Source
# dependencies and ZERO_CHECK stay in the workspace for Visual Studio builds.
#
# Call once, at the end of the root CMakeLists.txt, after every target exists.

function(pixie_collect_targets directory out)
    get_property(targets DIRECTORY ${directory} PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirectories DIRECTORY ${directory} PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        pixie_collect_targets(${subdirectory} nested)
        list(APPEND targets ${nested})
    endforeach()
    set(${out} ${targets} PARENT_SCOPE)
endfunction()

function(pixie_write_root_solution)
    # The Pixie workspace consumes the default Visual Studio build directory.
    if(NOT CMAKE_GENERATOR MATCHES "^Visual Studio"
       OR NOT CMAKE_BINARY_DIR STREQUAL "${PROJECT_SOURCE_DIR}/build")
        return()
    endif()

    pixie_collect_targets(${PROJECT_SOURCE_DIR} targets)
    get_property(startup DIRECTORY ${PROJECT_SOURCE_DIR} PROPERTY VS_STARTUP_PROJECT)

    # Group the projects by their FOLDER property; a project without one goes to the root.
    set(folders "")
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY")
            continue()
        endif()
        get_target_property(folder ${target} FOLDER)
        if(NOT folder)
            set(folder "")
        endif()
        get_target_property(binaryDir ${target} BINARY_DIR)
        file(RELATIVE_PATH path "${CMAKE_BINARY_DIR}" "${binaryDir}/${target}.vcxproj")
        set(attributes "")
        if(target STREQUAL startup)
            set(attributes " DefaultStartup=\"true\"")
        endif()
        string(MAKE_C_IDENTIFIER "folder_${folder}" key)
        string(APPEND ${key} "\t\t<Project Path=\"${path}\"${attributes}/>\n")
        list(APPEND folders "${folder}")
    endforeach()
    if(NOT CMAKE_SUPPRESS_REGENERATION)
        file(RELATIVE_PATH path "${CMAKE_BINARY_DIR}" "${CMAKE_BINARY_DIR}/ZERO_CHECK.vcxproj")
        set(folder "cmake")
        string(MAKE_C_IDENTIFIER "folder_${folder}" key)
        string(APPEND ${key} "\t\t<Project Path=\"${path}\"/>\n")
        list(APPEND folders "${folder}")
    endif()
    list(REMOVE_DUPLICATES folders)
    list(SORT folders)

    set(content "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n")
    string(APPEND content "<!-- Generated by cmake/PixieRootSolution.cmake on configure; do not edit. -->\n")
    string(APPEND content "<Solution>\n\t<Configurations>\n")
    foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
        string(APPEND content "\t\t<BuildType Name=\"${config}\"/>\n")
    endforeach()
    string(APPEND content "\t\t<Platform Name=\"${CMAKE_VS_PLATFORM_NAME}\"/>\n\t</Configurations>\n")
    foreach(folder IN LISTS folders)
        string(MAKE_C_IDENTIFIER "folder_${folder}" key)
        if(folder STREQUAL "")
            string(REPLACE "\t\t<" "\t<" projects "${${key}}")
            string(APPEND content "${projects}")
        else()
            string(APPEND content "\t<Folder Name=\"/${folder}/\">\n${${key}}\t</Folder>\n")
        endif()
    endforeach()
    string(APPEND content "</Solution>\n")

    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/PixieEngine.root.slnx" CONTENT "${content}" @ONLY)
endfunction()
