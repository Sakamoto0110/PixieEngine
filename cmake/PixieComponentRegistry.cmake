# Shared bootstrap for Add code and explicit adoption by a custom C++ project.
function(pixie_validate_generator_templates family)
    set(templates "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../templates/project-code")
    if(NOT EXISTS "${templates}/versions.json")
        message(FATAL_ERROR "The selected generator is missing its template version inventory")
    endif()
    file(READ "${templates}/versions.json" inventory)
    string(JSON schema GET "${inventory}" schemaVersion)
    string(JSON policy GET "${inventory}" hashPolicy)
    string(JSON count LENGTH "${inventory}" families "${family}" templates)
    if(NOT schema STREQUAL "1" OR NOT policy STREQUAL "utf8-lf" OR count LESS 1)
        message(FATAL_ERROR "Unsupported generator family/template inventory")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON relative GET "${inventory}" families "${family}" templates ${index})
        if(NOT relative MATCHES "^([A-Za-z0-9_-]+/)?[A-Za-z0-9_.-]+\\.in$" OR
           NOT EXISTS "${templates}/${relative}" OR IS_SYMLINK "${templates}/${relative}")
            message(FATAL_ERROR "Missing or invalid versioned template: ${relative}")
        endif()
        file(READ "${templates}/${relative}" bytes)
        string(REPLACE "\r\n" "\n" canonical "${bytes}")
        string(SHA256 actual "${canonical}")
        string(JSON expected GET "${inventory}" sha256 "${relative}")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Versioned template was modified: ${relative}; no project files were written")
        endif()
    endforeach()
endfunction()

function(pixie_initialize_component_registry directory project_id)
    if(NOT DEFINED PIXIE_GENERATOR_FAMILY)
        set(PIXIE_GENERATOR_FAMILY custom-v1)
    endif()
    if(NOT PIXIE_GENERATOR_FAMILY MATCHES "^(registered-v1|sdk-v1|custom-v1)$")
        message(FATAL_ERROR "Unknown component generator family")
    endif()
    pixie_validate_generator_templates("${PIXIE_GENERATOR_FAMILY}")
    foreach(path src/PixieComponents.generated.hpp src/PixieComponents.generated.cpp .pixie-code/Components.cmake .pixie-code/manifest.json)
        if(EXISTS "${directory}/${path}" OR IS_SYMLINK "${directory}/${path}")
            message(FATAL_ERROR "Refusing to replace an existing registry file: ${path}")
        endif()
    endforeach()
    foreach(path src .pixie-code)
        if(EXISTS "${directory}/${path}" AND NOT IS_DIRECTORY "${directory}/${path}")
            message(FATAL_ERROR "A registry directory is an existing file: ${path}")
        endif()
        if(IS_SYMLINK "${directory}/${path}")
            message(FATAL_ERROR "Registry destinations must not be linked directories: ${path}")
        endif()
    endforeach()
    set(templates "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../templates/project-code")
    configure_file("${templates}/Components.hpp.in" "${directory}/src/PixieComponents.generated.hpp" @ONLY)
    configure_file("${templates}/Components.cpp.in" "${directory}/src/PixieComponents.generated.cpp" @ONLY)
    configure_file("${templates}/Components.cmake.in" "${directory}/.pixie-code/Components.cmake" @ONLY)
    file(SHA256 "${directory}/src/PixieComponents.generated.hpp" header_hash)
    file(SHA256 "${directory}/src/PixieComponents.generated.cpp" source_hash)
    file(SHA256 "${directory}/.pixie-code/Components.cmake" cmake_hash)
    file(WRITE "${directory}/.pixie-code/manifest.json"
        "{\n  \"schemaVersion\": 1,\n  \"generatorFamily\": \"${PIXIE_GENERATOR_FAMILY}\",\n  \"projectId\": \"${project_id}\",\n  \"components\": [],\n  \"headerHash\": \"${header_hash}\",\n  \"sourceHash\": \"${source_hash}\",\n  \"cmakeHash\": \"${cmake_hash}\"\n}\n")
endfunction()
