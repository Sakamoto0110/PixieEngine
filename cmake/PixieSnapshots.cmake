# Only explicitly approved references become regression tests. Candidate generation never approves.
function(pixie_add_snapshot_tests)
    file(GLOB snapshot_manifests CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/samples/*/snapshots/scenarios.json")
    foreach(manifest IN LISTS snapshot_manifests)
        file(READ "${manifest}" snapshot_json)
        string(JSON scenario_count LENGTH "${snapshot_json}" scenarios)
        if(scenario_count EQUAL 0)
            continue()
        endif()
        get_filename_component(snapshot_directory "${manifest}" DIRECTORY)
        get_filename_component(sample_directory "${snapshot_directory}" DIRECTORY)
        get_filename_component(sample "${sample_directory}" NAME)
        math(EXPR last_scenario "${scenario_count} - 1")
        foreach(index RANGE ${last_scenario})
            string(JSON scenario MEMBER "${snapshot_json}" scenarios ${index})
            string(JSON approved GET "${snapshot_json}" scenarios "${scenario}" approved)
            if(NOT approved)
                continue()
            endif()
            find_package(Python3 REQUIRED COMPONENTS Interpreter)
            set(player pixie-player)
            if(TARGET ${sample})
                set(player ${sample})
            elseif(EXISTS "${sample_directory}/CMakeLists.txt")
                message(FATAL_ERROR "Approved snapshot needs the ${sample} target; enable its sample build")
            endif()
            add_test(NAME snapshot-${sample}-${scenario}
                COMMAND Python3::Interpreter "${PROJECT_SOURCE_DIR}/scripts/snapshot_capture.py"
                    --player $<TARGET_FILE:${player}> --project "${sample_directory}"
                    --manifest "${manifest}" --scenario "${scenario}"
                    --output "${PROJECT_BINARY_DIR}/snapshots/${sample}/${scenario}")
            set_tests_properties(snapshot-${sample}-${scenario} PROPERTIES RUN_SERIAL TRUE TIMEOUT 180 LABELS snapshot)
        endforeach()
    endforeach()
endfunction()
