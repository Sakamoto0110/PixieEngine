{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026, x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "ci",
      "displayName": "CI: Ninja Multi-Config, with the compiler of the developer environment it runs in",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-ci"
    }
  ],
  "buildPresets": [
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "ci-debug", "configurePreset": "ci", "configuration": "Debug" },
    { "name": "ci-release", "configurePreset": "ci", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ci-debug", "configurePreset": "ci", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "ci-release", "configurePreset": "ci", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
