endfunction()

function(snapshot output dir)
    file(GLOB_RECURSE files RELATIVE "${dir}" LIST_DIRECTORIES FALSE "${dir}/*")
    list(SORT files)
    set(result "")
    foreach(path IN LISTS files)
        file(SHA256 "${dir}/${path}" digest)
        string(APPEND result "${path}=${digest}\n")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(run_case name expected script project)
    snapshot(before "${project}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPIXIE_PROJECT_DIR=${project}" ${ARGN} -P "${script}"
        RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    file(WRITE "${work}/${name}.log" "${stdout}${stderr}")
    snapshot(after "${project}")
    if(expected STREQUAL "write")
        if(NOT code STREQUAL "0" OR before STREQUAL after)
            message(FATAL_ERROR "${name} did not produce project code: ${stdout}${stderr}")
        endif()
    elseif(expected STREQUAL "read")
        if(NOT code STREQUAL "0" OR NOT before STREQUAL after)
            message(FATAL_ERROR "${name} did not preserve the project: ${stdout}${stderr}")
        endif()
    elseif(code STREQUAL "0" OR NOT stderr MATCHES "${expected}" OR NOT before STREQUAL after)
        message(FATAL_ERROR "${name} did not refuse before writes (${expected}): ${stdout}${stderr}")
    endif()
    message(STATUS "passed: ${name}")
endfunction()

