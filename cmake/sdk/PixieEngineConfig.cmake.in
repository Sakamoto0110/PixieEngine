# Installed package only. No Engine sources, package registry fallback or dependency downloads.
function(_pixie_load_sdk_package)
include(CMakeFindDependencyMacro)
get_filename_component(_pixie_root "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
if(NOT DEFINED PIXIE_SDK_ROOT OR NOT IS_ABSOLUTE "${PIXIE_SDK_ROOT}")
    message(FATAL_ERROR "Select an explicit absolute PIXIE_SDK_ROOT before finding PixieEngine")
endif()
file(REAL_PATH "${PIXIE_SDK_ROOT}" _pixie_requested_root)
if(NOT _pixie_requested_root STREQUAL _pixie_root)
    message(FATAL_ERROR "PixieEngine_DIR conflicts with PIXIE_SDK_ROOT; use a new cache for the selected SDK")
endif()
if(NOT DEFINED PIXIE_SDK_PROFILE OR NOT PIXIE_SDK_PROFILE MATCHES "^(authoring|shipping|local-development)$")
    message(FATAL_ERROR "Select an explicit admitted PIXIE_SDK_PROFILE")
endif()
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    message(FATAL_ERROR "The installed SDK requires its exact Windows x64 MSVC tuple")
endif()
if(NOT EXISTS "${_pixie_root}/sdk.json")
    message(FATAL_ERROR "The selected SDK has no sdk.json; package mode never falls back to sources")
endif()
file(READ "${_pixie_root}/sdk.json" _pixie_manifest)
file(SHA256 "${_pixie_root}/sdk.json" _pixie_manifest_hash)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pixie_root}/sdk.json")
string(JSON _pixie_schema GET "${_pixie_manifest}" schemaVersion)
string(JSON _pixie_schema_type TYPE "${_pixie_manifest}" schemaVersion)
string(JSON _pixie_sdk_id GET "${_pixie_manifest}" sdkId)
string(JSON _pixie_distribution GET "${_pixie_manifest}" distributionClass)
if(NOT _pixie_distribution MATCHES "^(public|local-private)$")
    message(FATAL_ERROR "Unknown SDK distribution class")
endif()
if(NOT _pixie_schema_type STREQUAL "NUMBER" OR NOT _pixie_schema STREQUAL "1" OR
   NOT _pixie_sdk_id MATCHES "^[0-9a-f]+$" OR NOT _pixie_sdk_id STREQUAL "@sdk_id@")
    message(FATAL_ERROR "The installed SDK schema/identity does not match its package config")
endif()
if((_pixie_distribution STREQUAL "public" AND PIXIE_SDK_PROFILE STREQUAL "local-development") OR
   (_pixie_distribution STREQUAL "local-private" AND NOT PIXIE_SDK_PROFILE STREQUAL "local-development"))
    message(FATAL_ERROR "The selected profile is not part of this public/private SDK distribution")
endif()
set(_pixie_selection "${_pixie_root}|${_pixie_manifest_hash}|${PIXIE_SDK_PROFILE}|${CMAKE_BUILD_TYPE}|${CMAKE_CONFIGURATION_TYPES}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_MSVC_RUNTIME_LIBRARY}")
if(DEFINED PIXIE_SDK_BOUND_SELECTION AND NOT PIXIE_SDK_BOUND_SELECTION STREQUAL _pixie_selection)
    message(FATAL_ERROR "This cache belongs to another immutable SDK/profile; choose a new build directory")
endif()
set(PIXIE_SDK_BOUND_SELECTION "${_pixie_selection}" CACHE INTERNAL "Exact installed SDK cache identity")
if(TARGET Pixie::Shared)
    get_property(_pixie_prior GLOBAL PROPERTY PIXIE_IMPORTED_SDK_SELECTION)
    if(NOT _pixie_prior STREQUAL _pixie_selection)
        message(FATAL_ERROR "Multiple different SDKs cannot own the same public targets")
    endif()
    set(_pixie_already_loaded TRUE)
endif()

function(_pixie_installed_path output relative)
    if(relative STREQUAL "" OR IS_ABSOLUTE "${relative}" OR relative MATCHES "[\\\\:]" OR
       relative MATCHES "(^|/)\\.\\.?(/|$)" OR relative MATCHES "//")
        message(FATAL_ERROR "Invalid SDK-relative payload path: ${relative}")
    endif()
    file(REAL_PATH "${_pixie_root}/${relative}" resolved)
    string(TOLOWER "${_pixie_root}/" prefix)
    string(TOLOWER "${resolved}" candidate)
    string(FIND "${candidate}" "${prefix}" inside)
    if(NOT inside EQUAL 0)
        message(FATAL_ERROR "SDK payload leaves its root: ${relative}")
    endif()
    set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

# Validate the exact payload before publishing imported targets. Missing headers/math
# archives are a package error, never an invitation to rebuild or find another copy.
string(JSON _pixie_file_count LENGTH "${_pixie_manifest}" files)
if(_pixie_file_count LESS 1)
    message(FATAL_ERROR "The selected SDK has no payload inventory")
endif()
math(EXPR _pixie_last_file "${_pixie_file_count} - 1")
set(_pixie_declared_files "")
set(_pixie_folded_files "")
foreach(index RANGE 0 ${_pixie_last_file})
    string(JSON relative GET "${_pixie_manifest}" files ${index} path)
    string(JSON size GET "${_pixie_manifest}" files ${index} size)
    string(JSON size_type TYPE "${_pixie_manifest}" files ${index} size)
    string(JSON expected GET "${_pixie_manifest}" files ${index} sha256)
    if(NOT size_type STREQUAL "NUMBER" OR NOT size MATCHES "^[0-9]+$")
        message(FATAL_ERROR "SDK file size must be a nonnegative integer: ${relative}")
    endif()
    string(TOLOWER "${relative}" folded)
    if(folded IN_LIST _pixie_folded_files OR relative STREQUAL "sdk.json")
        message(FATAL_ERROR "Duplicate/case-colliding/recursive SDK inventory: ${relative}")
    endif()
    _pixie_installed_path(absolute "${relative}")
    if(NOT EXISTS "${absolute}" OR IS_DIRECTORY "${absolute}")
        message(FATAL_ERROR "Missing SDK payload: ${relative}")
    endif()
    file(SIZE "${absolute}" actual_size)
    file(SHA256 "${absolute}" actual_hash)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${absolute}")
    if(NOT actual_size EQUAL size OR NOT actual_hash STREQUAL expected)
        message(FATAL_ERROR "Mixed/modified SDK payload: ${relative}")
    endif()
    if(_pixie_distribution STREQUAL "public" AND folded MATCHES "(devchannel/|pixie-mcp|local-development/|localcommandchannel\\.hpp|pixie/events/)")
        message(FATAL_ERROR "Private/unsupported payload in the public SDK: ${relative}")
    endif()
    list(APPEND _pixie_declared_files "${relative}")
    list(APPEND _pixie_folded_files "${folded}")
endforeach()
file(GLOB_RECURSE _pixie_actual_files CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE RELATIVE "${_pixie_root}" "${_pixie_root}/*")
list(REMOVE_ITEM _pixie_actual_files sdk.json)
list(SORT _pixie_actual_files)
list(SORT _pixie_declared_files)
if(NOT _pixie_actual_files STREQUAL _pixie_declared_files)
    message(FATAL_ERROR "Undeclared or missing SDK payload; verify this exact immutable package")
endif()

if(CMAKE_CONFIGURATION_TYPES)
    set(_pixie_configurations ${CMAKE_CONFIGURATION_TYPES})
elseif(CMAKE_BUILD_TYPE)
    set(_pixie_configurations "${CMAKE_BUILD_TYPE}")
else()
    message(FATAL_ERROR "Configure an explicit native CMAKE_BUILD_TYPE or CMAKE_CONFIGURATION_TYPES")
endif()
string(JSON _pixie_profile_count LENGTH "${_pixie_manifest}" profiles)
math(EXPR _pixie_last_profile "${_pixie_profile_count} - 1")
set(_pixie_supported "")
foreach(configuration IN LISTS _pixie_configurations)
    if(NOT configuration MATCHES "^(Debug|Release)$" OR (PIXIE_SDK_PROFILE STREQUAL "shipping" AND NOT configuration STREQUAL "Release"))
        message(FATAL_ERROR "Unsupported SDK configuration ${configuration}; no configuration remapping is allowed")
    endif()
    set(found FALSE)
    foreach(index RANGE 0 ${_pixie_last_profile})
        string(JSON profile GET "${_pixie_manifest}" profiles ${index} profile)
        string(JSON native_configuration GET "${_pixie_manifest}" profiles ${index} configuration)
        if(profile STREQUAL PIXIE_SDK_PROFILE AND native_configuration STREQUAL configuration)
            if(found)
                message(FATAL_ERROR "Duplicate selected SDK profile/configuration")
            endif()
            set(found TRUE)
            string(JSON relative GET "${_pixie_manifest}" profiles ${index} manifest)
            string(JSON expected_profile_hash GET "${_pixie_manifest}" profiles ${index} manifestSha256)
            if(NOT relative STREQUAL "profiles/${profile}/${configuration}/profile.json")
                message(FATAL_ERROR "Selected SDK profile manifest has an invalid path")
            endif()
            _pixie_installed_path(profile_path "${relative}")
            file(SHA256 "${profile_path}" profile_hash)
            if(NOT profile_hash STREQUAL expected_profile_hash)
                message(FATAL_ERROR "Selected SDK profile manifest hash mismatch")
            endif()
            file(READ "${profile_path}" identity)
            string(JSON compiler GET "${identity}" compilerVersion)
            string(JSON sdk_id GET "${identity}" sdkId)
            string(JSON distribution GET "${identity}" distributionClass)
            string(JSON architecture GET "${identity}" architecture)
            string(JSON windows_sdk GET "${identity}" windowsSdkVersion)
            if(NOT compiler STREQUAL CMAKE_CXX_COMPILER_VERSION OR NOT sdk_id STREQUAL _pixie_sdk_id OR
               NOT distribution STREQUAL _pixie_distribution OR NOT architecture STREQUAL "x64")
                message(FATAL_ERROR "The selected SDK/compiler/architecture tuple is incompatible")
            endif()
            set(actual_windows_sdk "${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}")
            if(NOT actual_windows_sdk)
                set(actual_windows_sdk "$ENV{WindowsSDKVersion}")
                string(REGEX REPLACE "[/\\]+$" "" actual_windows_sdk "${actual_windows_sdk}")
            endif()
            if(NOT windows_sdk STREQUAL actual_windows_sdk)
                message(FATAL_ERROR "The Windows SDK toolchain does not match the selected native SDK")
            endif()
            string(TOUPPER "${configuration}" upper)
            string(JSON runtime GET "${identity}" runtime path)
            string(JSON player GET "${identity}" player path)
            if(NOT runtime STREQUAL "profiles/${profile}/${configuration}/bin/pixie.dll" OR
               NOT player STREQUAL "profiles/${profile}/${configuration}/bin/pixie-player.exe")
                message(FATAL_ERROR "Selected runtime/player points outside its exact SDK tuple")
            endif()
            _pixie_installed_path(_pixie_runtime_${upper} "${runtime}")
            _pixie_installed_path(_pixie_player_${upper} "${player}")
            set(_pixie_tuple_${upper} "${_pixie_root}/profiles/${profile}/${configuration}")
            foreach(link_input pixie.lib pixie_math.lib)
                if(NOT "profiles/${profile}/${configuration}/lib/${link_input}" IN_LIST _pixie_declared_files)
                    message(FATAL_ERROR "SDK tuple omits a required link input: ${link_input}")
                endif()
            endforeach()
            set(_pixie_runtime_files_${upper} "${_pixie_runtime_${upper}}")
            string(JSON dependency_count LENGTH "${identity}" nativeDependencies)
            if(dependency_count GREATER 0)
                math(EXPR last_dependency "${dependency_count} - 1")
                foreach(dependency RANGE 0 ${last_dependency})
                    string(JSON relative_dependency GET "${identity}" nativeDependencies ${dependency} path)
                    _pixie_installed_path(absolute_dependency "${relative_dependency}")
                    list(APPEND _pixie_runtime_files_${upper} "${absolute_dependency}")
                endforeach()
            endif()
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "The selected SDK has no ${PIXIE_SDK_PROFILE}/${configuration}; no source/config fallback")
    endif()
    list(APPEND _pixie_supported "${configuration}")
endforeach()

if(NOT _pixie_already_loaded)
foreach(dependency pixie::pixie pixie::math EnTT::EnTT)
    if(TARGET ${dependency})
        message(FATAL_ERROR "An unselected dependency already owns ${dependency}; use the SDK's contained closure")
    endif()
endforeach()
if(NOT TARGET OpenGL::GL)
    set(_pixie_create_opengl TRUE)
endif()
find_dependency(OpenGL REQUIRED)
if(_pixie_create_opengl)
    set_property(TARGET OpenGL::GL PROPERTY IMPORTED_GLOBAL TRUE)
endif()
add_library(pixie::pixie INTERFACE IMPORTED GLOBAL)
set_target_properties(pixie::pixie PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_pixie_root}/third-party/include" INTERFACE_COMPILE_FEATURES cxx_std_20)
add_library(EnTT::EnTT INTERFACE IMPORTED GLOBAL)
set_target_properties(EnTT::EnTT PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_pixie_root}/third-party/include" INTERFACE_COMPILE_FEATURES cxx_std_20)
add_library(pixie::math STATIC IMPORTED GLOBAL)
set_target_properties(pixie::math PROPERTIES IMPORTED_CONFIGURATIONS "${_pixie_supported}"
    INTERFACE_LINK_LIBRARIES pixie::pixie INTERFACE_INCLUDE_DIRECTORIES "${_pixie_root}/third-party/include"
    INTERFACE_COMPILE_DEFINITIONS "GLM_FORCE_EXPLICIT_CTOR;GLM_FORCE_CTOR_INIT" INTERFACE_COMPILE_FEATURES cxx_std_20)
add_library(Pixie::Shared SHARED IMPORTED GLOBAL)
set_target_properties(Pixie::Shared PROPERTIES IMPORTED_CONFIGURATIONS "${_pixie_supported}"
    INTERFACE_LINK_LIBRARIES "pixie::math;EnTT::EnTT;OpenGL::GL"
    INTERFACE_INCLUDE_DIRECTORIES "${_pixie_root}/include;${_pixie_root}/third-party/include;${_pixie_root}/profiles/${PIXIE_SDK_PROFILE}/$<CONFIG>/include"
    INTERFACE_COMPILE_DEFINITIONS GLEW_NO_GLU INTERFACE_COMPILE_FEATURES cxx_std_20
    INTERFACE_COMPILE_OPTIONS "/arch:AVX2;/FI${_pixie_root}/profiles/${PIXIE_SDK_PROFILE}/$<CONFIG>/include/pixie_sdk_build.h")
if(NOT PIXIE_SDK_PROFILE STREQUAL "shipping")
    set_property(TARGET Pixie::Shared APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS PIXIE_DEVELOPMENT)
endif()
if(PIXIE_SDK_PROFILE STREQUAL "local-development")
    set_property(TARGET Pixie::Shared APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS PIXIE_DEV_CHANNEL)
endif()
foreach(configuration IN LISTS _pixie_supported)
    string(TOUPPER "${configuration}" upper)
    set_property(TARGET Pixie::Shared PROPERTY IMPORTED_LOCATION_${upper} "${_pixie_runtime_${upper}}")
    set_property(TARGET Pixie::Shared PROPERTY IMPORTED_IMPLIB_${upper} "${_pixie_tuple_${upper}}/lib/pixie.lib")
    set_property(TARGET Pixie::Shared PROPERTY PIXIE_RUNTIME_FILES_${upper} "${_pixie_runtime_files_${upper}}")
    set_property(TARGET pixie::math PROPERTY IMPORTED_LOCATION_${upper} "${_pixie_tuple_${upper}}/lib/pixie_math.lib")
endforeach()
foreach(boundary Core Platform Render App Runtime Engine)
    add_library(Pixie::${boundary} INTERFACE IMPORTED GLOBAL)
    set_target_properties(Pixie::${boundary} PROPERTIES INTERFACE_LINK_LIBRARIES Pixie::Shared)
endforeach()
endif()
set_property(GLOBAL PROPERTY PIXIE_IMPORTED_SDK_SELECTION "${_pixie_selection}")
set(PixieEngine_SDK_ID "${_pixie_sdk_id}")
set(PixieEngine_MANIFEST_SHA256 "${_pixie_manifest_hash}")
set(PixieEngine_CONFIGURATIONS "${_pixie_supported}")
set(PixieEngine_RUNTIME_DIRECTORY "${_pixie_root}/profiles/${PIXIE_SDK_PROFILE}/$<CONFIG>/bin")
set(PixieEngine_RUNTIME_DLLS "")
foreach(configuration IN LISTS _pixie_supported)
    string(TOUPPER "${configuration}" upper)
    foreach(file IN LISTS _pixie_runtime_files_${upper})
        list(APPEND PixieEngine_RUNTIME_DLLS "$<$<CONFIG:${configuration}>:${file}>")
    endforeach()
endforeach()

function(pixie_stage_runtime target)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "pixie_stage_runtime requires an existing consuming target")
    endif()
    get_target_property(configurations Pixie::Shared IMPORTED_CONFIGURATIONS)
    set(script "")
    foreach(configuration IN LISTS configurations)
        string(TOUPPER "${configuration}" upper)
        get_target_property(files Pixie::Shared PIXIE_RUNTIME_FILES_${upper})
        string(APPEND script "if(\"$<CONFIG>\" STREQUAL \"${configuration}\")\n")
        foreach(file IN LISTS files)
            string(APPEND script "file(COPY \"${file}\" DESTINATION \"$<TARGET_FILE_DIR:${target}>\")\n")
        endforeach()
        string(APPEND script "endif()\n")
    endforeach()
    set(path "${CMAKE_CURRENT_BINARY_DIR}/pixie-stage-${target}-$<CONFIG>.cmake")
    file(GENERATE OUTPUT "${path}" CONTENT "${script}")
    add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -P "${path}" VERBATIM)
endfunction()
foreach(output PixieEngine_SDK_ID PixieEngine_MANIFEST_SHA256 PixieEngine_CONFIGURATIONS
    PixieEngine_RUNTIME_DIRECTORY PixieEngine_RUNTIME_DLLS)
    set(${output} "${${output}}" PARENT_SCOPE)
endforeach()
endfunction()
_pixie_load_sdk_package()
