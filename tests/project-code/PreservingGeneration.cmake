function(tuple sdk name config distribution module automation output)
    set(path "profiles/${name}/${config}/profile.json")
    file(WRITE "${sdk}/${path}"
        "{\"sdkId\":\"${id}\",\"sdkBuildId\":\"${build}\",\"profile\":\"${name}\",\"configuration\":\"${config}\","
        "\"distributionClass\":\"${distribution}\",\"platform\":\"windows\",\"architecture\":\"x64\","
        "\"compilerVersion\":\"19.51.36260.0\",\"cpuFeatures\":[\"avx2\",\"fma\",\"f16c\"],"
        "\"capabilities\":{\"moduleLoading\":${module},\"candidateAuthoring\":true,\"nativeAutomation\":${automation}}}\n")
    file(SHA256 "${sdk}/${path}" digest)
    set(${output} "{\"profile\":\"${name}\",\"configuration\":\"${config}\",\"sdkBuildId\":\"${build}\",\"manifest\":\"${path}\",\"manifestSha256\":\"${digest}\"}" PARENT_SCOPE)
endfunction()

