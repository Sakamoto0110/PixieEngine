# Explicit build-product v2 inputs. The export tool hashes built outputs after build;
# post-build bytes cannot be precomputed by file(GENERATE).
function(pixie_export_product target)
    cmake_parse_arguments(PARSE_ARGV 1 PRODUCT "" "" "ASSETS;LIBRARIES")
    if(PRODUCT_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown pixie_export_product arguments: ${PRODUCT_UNPARSED_ARGUMENTS}")
    endif()
    set(assets "")
    foreach(file IN LISTS PRODUCT_ASSETS)
        if(IS_ABSOLUTE "${file}" OR file MATCHES "(^|/)\\.\\.(/|$)" OR file MATCHES "[\\\";]")
            message(FATAL_ERROR "Export ASSETS must be portable project-relative paths")
        endif()
        if(assets)
            string(APPEND assets ",")
        endif()
        string(APPEND assets "\"${file}\"")
    endforeach()
    # Source/authoring builds may still emit local diagnostics, but must not be
    # relabeled as installed shipping products or force an installed SDK to build.
    set(identity "{}")
    set(sdk_id "")
    set(build_id "")
    set(runtime "{}")
    set(dependencies "")
    set(source_marker ",\"sourceDevelopment\":true")
    if(DEFINED PIXIE_SDK_ROOT AND PIXIE_SDK_PROFILE STREQUAL "shipping" AND
       PIXIE_PROJECT_BUILD_ROLE STREQUAL "shipping-export")
        if(NOT IS_ABSOLUTE "${PIXIE_SDK_ROOT}" OR NOT EXISTS "${PIXIE_SDK_ROOT}/sdk.json" OR
           NOT EXISTS "${PIXIE_SDK_ROOT}/profiles/shipping/Release/profile.json")
            message(FATAL_ERROR "Export products require the explicitly selected installed shipping SDK")
        endif()
        file(READ "${PIXIE_SDK_ROOT}/profiles/shipping/Release/profile.json" identity)
        string(JSON sdk_id GET "${identity}" sdkId)
        string(JSON build_id GET "${identity}" sdkBuildId)
        string(JSON runtime_path GET "${identity}" runtime path)
        string(JSON runtime_hash GET "${identity}" runtime sha256)
        set(runtime "{\"sdkPath\":\"${runtime_path}\",\"sha256\":\"${runtime_hash}\"}")
        string(JSON external_count LENGTH "${identity}" externalRuntimeDependencies)
        if(external_count GREATER 0)
            message(FATAL_ERROR "Export requires the SDK's contained native/CRT dependencies")
        endif()
        string(JSON count LENGTH "${identity}" nativeDependencies)
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON relative GET "${identity}" nativeDependencies ${index} path)
                string(TOLOWER "${relative}" folded)
                if(NOT folded MATCHES "^profiles/shipping/release/bin/[^/]+\\.dll$" OR relative STREQUAL runtime_path)
                    message(FATAL_ERROR "Invalid shipping native dependency reference: ${relative}")
                endif()
                string(JSON digest GET "${identity}" nativeDependencies ${index} sha256)
                if(dependencies)
                    string(APPEND dependencies ",")
                endif()
                set(role "library")
                if(folded MATCHES "/(msvcp|vcruntime|concrt)[^/]*\\.dll$")
                    set(role "runtime")
                endif()
                string(APPEND dependencies "{\"sdkPath\":\"${relative}\",\"sha256\":\"${digest}\",\"role\":\"${role}\"}")
            endforeach()
        endif()
        set(source_marker "")
    endif()
    foreach(library IN LISTS PRODUCT_LIBRARIES)
        if(TARGET "${library}")
            set(source "$<TARGET_FILE:${library}>")
            set(destination "$<TARGET_FILE_NAME:${library}>")
        elseif(IS_ABSOLUTE "${library}" AND NOT library MATCHES "[\";\n\r]")
            file(TO_CMAKE_PATH "${library}" source)
            get_filename_component(destination "${source}" NAME)
        else()
            message(FATAL_ERROR "Export LIBRARIES must name declared targets or explicit absolute DLL inputs")
        endif()
        if(dependencies)
            string(APPEND dependencies ",")
        endif()
        string(APPEND dependencies "{\"source\":\"${source}\",\"destination\":\"${destination}\",\"role\":\"library\"}")
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/pixie-export/$<CONFIG>/${target}.json" CONTENT
"{\n\"format\":\"pixie-product\",\"version\":2,\"configuration\":\"$<CONFIG>\",
\"development\":$<IF:$<BOOL:${PIXIE_DEVELOPMENT}>,true,false>,
\"dev_channel\":$<IF:$<BOOL:${PIXIE_DEV_CHANNEL}>,true,false>${source_marker},
\"sdkId\":\"${sdk_id}\",\"sdkBuildId\":\"${build_id}\",\"runtimeIdentity\":${identity},
\"player\":{\"source\":\"$<TARGET_FILE:${target}>\",\"destination\":\"$<TARGET_FILE_NAME:${target}>\"},
\"runtime\":${runtime},\"dependencies\":[${dependencies}],\"assets\":[${assets}]}\n")
endfunction()
